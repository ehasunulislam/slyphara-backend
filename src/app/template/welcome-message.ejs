<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to Sylphara AI</title>
</head>

<body style="margin:0;padding:0;background:#0f172a;font-family:Arial,sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 20px;">
    <tr>
      <td align="center">

        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          style="
            background:#111827;
            border-radius:20px;
            overflow:hidden;
            border:1px solid #1f2937;
          "
        >

          <!-- Header -->
          <tr>
            <td align="center" style="padding:40px 30px 20px;">
              <h1
                style="
                  margin:0;
                  color:#ffffff;
                  font-size:34px;
                  font-weight:700;
                "
              >
                Sylphara AI
              </h1>

              <p
                style="
                  color:#9ca3af;
                  margin-top:10px;
                  font-size:15px;
                "
              >
                Your Intelligent AI Companion
              </p>
            </td>
          </tr>

          <!-- Welcome Section -->
          <tr>
            <td style="padding:20px 40px;">
              <h2
                style="
                  color:#ffffff;
                  margin-bottom:20px;
                "
              >
                Welcome, <%= name %> 👋
              </h2>

              <p
                style="
                  color:#d1d5db;
                  font-size:16px;
                  line-height:1.8;
                "
              >
                We're excited to have you join
                <strong style="color:#ffffff;">
                  Sylphara AI
                </strong>.
              </p>

              <p
                style="
                  color:#d1d5db;
                  font-size:16px;
                  line-height:1.8;
                "
              >
                Your account has been successfully created.
                You can now start intelligent conversations,
                organize your chats, and explore the power of AI
                in a clean and productive environment.
              </p>

              <div
                style="
                  text-align:center;
                  margin:40px 0;
                "
              >
                <a
                  href="https://sylphara.vercel.app"
                  style="
                    display:inline-block;
                    background:#2563eb;
                    color:#ffffff;
                    text-decoration:none;
                    padding:14px 32px;
                    border-radius:12px;
                    font-weight:600;
                  "
                >
                  Start Chatting
                </a>
              </div>

              <p
                style="
                  color:#9ca3af;
                  font-size:14px;
                  line-height:1.7;
                "
              >
                If you didn't create this account,
                please ignore this email.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                border-top:1px solid #1f2937;
                padding:25px;
              "
            >
              <p
                style="
                  margin:0;
                  color:#6b7280;
                  font-size:13px;
                "
              >
                © <%= new Date().getFullYear() %> Sylphara AI.
                All rights reserved.
              </p>

              <p
                style="
                  margin-top:8px;
                  color:#6b7280;
                  font-size:12px;
                "
              >
                Intelligent Conversations • Modern Experience
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>