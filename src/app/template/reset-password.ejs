<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password Reset Successful</title>
</head>

<body
  style="
    margin:0;
    padding:0;
    background:#0f172a;
    font-family:Arial, Helvetica, sans-serif;
  "
>
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 20px;">
    <tr>
      <td align="center">

        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          style="
            background:#111827;
            border-radius:20px;
            overflow:hidden;
            border:1px solid #1f2937;
          "
        >

          <!-- Header -->
          <tr>
            <td align="center" style="padding:40px 30px 20px;">
              <h1
                style="
                  margin:0;
                  color:#ffffff;
                  font-size:34px;
                  font-weight:700;
                "
              >
                Sylphara AI
              </h1>

              <p
                style="
                  color:#9ca3af;
                  margin-top:10px;
                  font-size:15px;
                "
              >
                Security Notification
              </p>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding:20px 40px 40px;">

              <div style="text-align:center; margin-bottom:25px;">
                <div
                  style="
                    display:inline-block;
                    width:80px;
                    height:80px;
                    line-height:80px;
                    border-radius:50%;
                    background:#22c55e20;
                    color:#22c55e;
                    font-size:40px;
                    font-weight:bold;
                  "
                >
                  ✓
                </div>
              </div>

              <h2
                style="
                  color:#ffffff;
                  text-align:center;
                  margin-bottom:20px;
                "
              >
                Password Reset Successful
              </h2>

              <p
                style="
                  color:#d1d5db;
                  font-size:16px;
                  line-height:1.8;
                  text-align:center;
                "
              >
                Hello <strong><%= name %></strong>,
              </p>

              <p
                style="
                  color:#d1d5db;
                  font-size:16px;
                  line-height:1.8;
                  text-align:center;
                "
              >
                Your Sylphara AI account password has been
                successfully changed.
              </p>

              <div
                style="
                  background:#1e293b;
                  border-radius:12px;
                  padding:18px;
                  margin:30px 0;
                "
              >
                <p
                  style="
                    color:#ffffff;
                    margin:0;
                    text-align:center;
                    font-size:15px;
                    line-height:1.7;
                  "
                >
                  If you made this change, no further action is required.
                </p>
              </div>

              <p
                style="
                  color:#f87171;
                  font-size:15px;
                  line-height:1.8;
                  text-align:center;
                "
              >
                If you did not change your password, please reset it
                immediately and contact support.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                border-top:1px solid #1f2937;
                padding:25px;
              "
            >
              <p
                style="
                  margin:0;
                  color:#6b7280;
                  font-size:13px;
                "
              >
                © Sylphara AI. All rights reserved.
              </p>

              <p
                style="
                  margin-top:8px;
                  color:#6b7280;
                  font-size:12px;
                "
              >
                Intelligent Conversations • Secure Accounts
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>