<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sylphara AI - OTP Verification</title>
</head>
<body style="margin:0; padding:0; background:#0a0a0a; font-family:Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 20px;">
    <tr>
      <td align="center">

        <table width="600" cellpadding="0" cellspacing="0"
          style="
            background:#111827;
            border:1px solid #1f2937;
            border-radius:20px;
            overflow:hidden;
          ">

          <!-- Header -->
          <tr>
            <td align="center" style="padding:40px 20px 20px;">
              <h1
                style="
                  margin:0;
                  color:#ffffff;
                  font-size:32px;
                  font-weight:700;
                "
              >
                Sylphara AI
              </h1>

              <p
                style="
                  margin-top:10px;
                  color:#9ca3af;
                  font-size:14px;
                "
              >
                Intelligent Conversations. Seamless Experience.
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:20px 40px;">

              <h2
                style="
                  color:#ffffff;
                  font-size:24px;
                  margin-bottom:15px;
                "
              >
                Verify Your Account
              </h2>

              <p
                style="
                  color:#d1d5db;
                  font-size:16px;
                  line-height:1.7;
                "
              >
                Welcome to Sylphara AI.
                Use the verification code below to complete your account verification.
              </p>

              <!-- OTP Box -->
              <div
                style="
                  margin:35px 0;
                  text-align:center;
                "
              >
                <span
                  style="
                    display:inline-block;
                    padding:18px 40px;
                    background:#2563eb;
                    color:#ffffff;
                    font-size:32px;
                    font-weight:700;
                    letter-spacing:8px;
                    border-radius:12px;
                  "
                >
                  <%= otp %>
                </span>
              </div>

              <p
                style="
                  color:#9ca3af;
                  font-size:14px;
                  line-height:1.6;
                "
              >
                This OTP is valid for
                <strong style="color:#ffffff;">
                  10 minutes
                </strong>.
                Please do not share this code with anyone.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                padding:25px;
                border-top:1px solid #1f2937;
              "
            >
              <p
                style="
                  margin:0;
                  color:#6b7280;
                  font-size:13px;
                "
              >
                © <%= new Date().getFullYear() %> Sylphara AI.
                All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>