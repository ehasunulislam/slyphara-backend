<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Your Password</title>
</head>

<body
  style="
    margin:0;
    padding:0;
    background:#0f172a;
    font-family:Arial, Helvetica, sans-serif;
  "
>
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 20px;">
    <tr>
      <td align="center">

        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          style="
            background:#111827;
            border-radius:20px;
            overflow:hidden;
            border:1px solid #1f2937;
          "
        >

          <!-- Header -->
          <tr>
            <td align="center" style="padding:40px 30px 20px;">
              <h1
                style="
                  margin:0;
                  color:#ffffff;
                  font-size:34px;
                  font-weight:700;
                "
              >
                Sylphara AI
              </h1>

              <p
                style="
                  color:#9ca3af;
                  margin-top:10px;
                  font-size:15px;
                "
              >
                Password Reset Verification
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding:20px 40px 40px;">
              <h2
                style="
                  color:#ffffff;
                  margin-bottom:20px;
                "
              >
                Reset Your Password
              </h2>

              <p
                style="
                  color:#d1d5db;
                  font-size:16px;
                  line-height:1.8;
                "
              >
                We received a request to reset your
                Sylphara AI account password.
              </p>

              <p
                style="
                  color:#d1d5db;
                  font-size:16px;
                  line-height:1.8;
                "
              >
                Use the following verification code to continue:
              </p>

              <!-- OTP Box -->
              <div
                style="
                  text-align:center;
                  margin:35px 0;
                "
              >
                <span
                  style="
                    display:inline-block;
                    background:#1e293b;
                    color:#60a5fa;
                    padding:18px 40px;
                    border-radius:14px;
                    font-size:32px;
                    font-weight:700;
                    letter-spacing:8px;
                  "
                >
                  <%= otp %>
                </span>
              </div>

              <p
                style="
                  color:#fbbf24;
                  font-size:14px;
                  line-height:1.7;
                "
              >
                This OTP is valid for a limited time.
              </p>

              <p
                style="
                  color:#9ca3af;
                  font-size:14px;
                  line-height:1.8;
                  margin-top:20px;
                "
              >
                If you did not request a password reset,
                please ignore this email. Your account
                will remain secure.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                border-top:1px solid #1f2937;
                padding:25px;
              "
            >
              <p
                style="
                  margin:0;
                  color:#6b7280;
                  font-size:13px;
                "
              >
                © Sylphara AI. All rights reserved.
              </p>

              <p
                style="
                  margin-top:8px;
                  color:#6b7280;
                  font-size:12px;
                "
              >
                Secure • Intelligent • Reliable
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>